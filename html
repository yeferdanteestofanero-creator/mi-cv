aside dl dt{font-size:11.5px;opacity:.7;margin-top:9px}
aside dl dd{font-size:13px;word-break:break-word}
aside ul{list-style:none}
aside li{font-size:13px;padding:3px 0}
main{padding:34px 34px 30px}
header h1{font-size:28px;line-height:1.15;font-weight:700;color:var(--side)}
header p{margin-top:6px;color:var(--accent);font-weight:600;font-size:15px}
section{margin-top:24px}
section h2{font-size:15px;font-weight:700;color:var(--side);padding-bottom:5px;border-bottom:2px solid var(--accent);margin-bottom:10px}
section p{max-width:66ch}
.item+.item{margin-top:12px}
.item strong{display:block}
.item span{color:var(--muted);font-size:13px}
.chips{display:flex;flex-wrap:wrap;gap:7px;list-style:none}
.chips li{border:1px solid var(--line);border-radius:3px;padding:3px 10px;font-size:13px;background:#f6f8fa}
@media (max-width:680px){body{padding:0}.cv{grid-template-columns:1fr}.foto{max-width:200px;margin:0 auto}main{padding:24px 20px}}
@media print{@page{size:A4;margin:0}body{background:none;padding:0}.cv{box-shadow:none;width:210mm;min-height:297mm}aside{-webkit-print-color-adjust:exact;print-color-adjust:exact}.chips li{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
